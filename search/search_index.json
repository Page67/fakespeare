e86v0.1\u5c1d\u8bd5\u7248\u3001v0.2\u66f4\u65b0\u7248\u5230\u76ee\u524dv1.0\u7b2c\u4e00\u7248</li> <li>\u76ee\u524d\u5904\u4e8ev1.0\u7b2c\u4e00\u7248\u6700\u540e\u6536\u5c3e\u9636\u6bb5</li> </ul>","tags":["projects","histmap"]},{"location":"project/2026/07/09/%E9%A1%B9%E7%9B%AE%E7%AE%80%E4%BB%8B%E7%9A%84%E7%AE%80%E4%BB%8B/#_4","title":"\u5de5\u4f5c\u65b9\u5f0f","text":"<ul> <li>AI\u8f85\u52a9\u7f16\u7a0b\uff08\u56e0\u4e3a\u4f5c\u8005\u7f16\u7a0b\u6c34\u5e73\u53ea\u6709Python101\u5165\u95e8\u7ea7\u522b\uff09</li> <li>\u5e73\u5747\u6bcf\u5929\u4e24\u5c0f\u65f6</li> </ul>","tags":["projects","histmap"]},{"location":"project/2026/07/09/%E9%A1%B9%E7%9B%AE%E7%AE%80%E4%BB%8B%E7%9A%84%E7%AE%80%E4%BB%8B/#agent","title":"Agent \u9009\u53d6","text":"<p>\u4f5c\u4e3a\u7b2c\u4e00\u4e2a\u9879\u76ee\uff0c\u9009\u62e9Cline\u8fd9\u4e2a\u7ecf\u5178\u7684VSCode\u5185\u7f6e\u578bAgent\u3002</p>","tags":["projects","histmap"]},{"location":"project/2026/07/09/%E9%A1%B9%E7%9B%AE%E7%AE%80%E4%BB%8B%E7%9A%84%E7%AE%80%E4%BB%8B/#_5","title":"\u6280\u672f\u6808","text":"\u6280\u672f\u9886\u57df \u9879\u76ee\u662f\u5426\u6d89\u53ca \u8986\u76d6\u7a0b\u5ea6 \u5907\u6ce8 \u524d\u7aef Web \u5df2\u6d89\u53ca \u9ad8 \u221a TypeScript / JS \u5de5\u7a0b \u5df2\u6d89\u53ca \u4e2d\u9ad8 \u221a \u4e92\u52a8\u5730\u56fe \u5df2\u6d89\u53ca \u9ad8 \u221a GIS \u684c\u9762\u5904\u7406 \u5df2\u6d89\u53ca \u9ad8 \u221a \u7a7a\u95f4\u6570\u636e\u683c\u5f0f \u5df2\u6d89\u53ca \u9ad8 \u221a \u7a7a\u95f4\u6570\u636e\u5e93 \u5df2\u6d89\u53ca \u4e2d\u9ad8 \u221a \u540e\u7aef API \u5df2\u5f00\u59cb/\u89c4\u5212 \u4e2d \u221a \u5730\u56fe\u670d\u52a1 / OGC \u5df2\u6d89\u53ca \u4e2d\u9ad8 \u221a \u4e91\u5b58\u50a8 / \u9759\u6001\u8d44\u4ea7 \u5df2\u6d89\u53ca \u4e2d\u9ad8 \u221a \u670d\u52a1\u5668\u90e8\u7f72 \u5df2\u5f00\u59cb \u4e2d \u4ecd\u9700\u8fdb\u4e00\u6b65\u5b66\u4e60 Git / \u7248\u672c\u7ba1\u7406 \u5df2\u6d89\u53ca \u4e2d \u221a Python \u6570\u636e\u811a\u672c \u5df2\u6d89\u53ca \u4e2d\u9ad8 \u221a AI agent \u5f00\u53d1\u6d41 \u5df2\u6d89\u53ca \u4e2d \u221a ==\u6d4b\u8bd5\u4f53\u7cfb== \u8f83\u5c11 \u4f4e \u4e2d\u540e\u671f CI/CD(Continuous Integration &amp; Continuous Delivery/Deployment) \u57fa\u672c\u672a\u6d89\u53ca \u4f4e \u540e\u671f&amp;\u6b63\u5f0f\u53d1\u5e03\u524d \u6743\u9650 / \u7528\u6237\u7cfb\u7edf \u57fa\u672c\u672a\u6d89\u53ca \u4f4e \u6700\u540e\u6d4b\u8bd5\u529f\u80fd\u548cv2.0\u7248\u672c \u53ef\u89c2\u6d4b\u6027 / \u65e5\u5fd7\u76d1\u63a7 \u57fa\u672c\u672a\u6d89\u53ca \u4f4e \u7f51\u7ad9\u6b63\u5f0f\u8fd0\u884c\u540e\u4f1a\u6709\u8f7b\u5fae\u63a5\u89e6 \u5bb9\u5668\u5316 / Docker \u51c6\u5907/\u4e86\u89e3\u4e2d \u4f4e\u5230\u4e2d \u4e2d\u540e\u671f ~~Kubernetes / \u5927\u89c4\u6a21\u8fd0\u7ef4~~ \u672a\u6d89\u53ca \u65e0 \u8001\u516d\u9636\u6bb5\u552f\u4e00\u4e0d\u9700\u8981\u771f\u6b63\u63a5\u89e6\u7684\u529f\u80fd \u79fb\u52a8\u7aef App \u672a\u6d89\u53ca \u65e0 \u9879\u76ee2\u89e3\u51b3 \u684c\u9762\u7aef App \u672a\u6d89\u53ca \u65e0 \u9879\u76ee2\u89e3\u51b3 ==\u6e38\u620f / 3D \u5f15\u64ce== \u672a\u6d89\u53ca \u65e0 \u9879\u76ee6\u3001\u9879\u76ee5\u89e3\u51b3 ==\u673a\u5668\u5b66\u4e60\u8bad\u7ec3\u5e73\u53f0== \u672a\u6b63\u5f0f\u6d89\u53ca \u4f4e \u8001\u516d\u7684open tail\uff0c\u65b0\u9879\u76ee\u7684\u9884\u70ed","tags":["projects","histmap"]},{"location":"project/2026/07/10/glrule-%E6%94%B9%E5%86%99/","title":"Agent Global Rules \u6539\u5199","text":"","tags":["projects","histmap","Agent"]},{"location":"project/2026/07/10/glrule-%E6%94%B9%E5%86%99/#_1","title":"\u524d\u60c5\u63d0\u8981","text":"<ol> <li>\u80cc\u666f</li> </ol> <p>\u4f7f\u7528Agent\u8f85\u52a9\u7f16\u7a0b\u8fdb\u884c\u9879\u76ee\u5f00\u53d1\u65f6\uff0c\u64b0\u5199 Global Rules\uff08\u5168\u5c40\u89c4\u5219\uff09 \u548c Project Rules\uff08\u9879\u76ee\u89c4\u5219\uff09 \u4f9b\u7ed9AI\u53c2\u8003\uff0c\u53ef\u4ee5\u66f4\u6709\u6548\u5730\u63a8\u8fdb\u9879\u76ee\u987a\u5229\u8fdb\u884c\u3002</p> <ol> <li>\u521d\u6b21\u4ea4\u6d41</li> </ol> <p>\u4f5c\u8005\u5728\u9879\u76ee\u5f00\u53d1\u4e2d\u9014\u5148\u624b\u5199\u4e86\u4e00\u7248\u89c4\u5219\uff0c\u7136\u540e\u8ba9AI\u7ed3\u540826\u5e74\u521d\u5f88\u6709\u540d\u7684Andrej Karpathy\u7ed9\u51fa\u7684AI\u7f16\u7a0b\u5efa\u8bae\u5bf9\u8be5\u89c4\u5219\u8fdb\u884c\u4fee\u6539\u5b8c\u5584\u3002AI\u7b2c\u4e00\u6b21\u4e3a\u6211\u751f\u6210\u4e863\u4e2a\u5168\u5c40\u89c4\u5219\u6587\u4ef6\u548c6\u4e2a\u9879\u76ee\u89c4\u5219\u6587\u4ef6\u2026\u2026\u8003\u8651\u5230\u89c4\u5219\u6587\u4ef6\u662fAgent\u8981\u9891\u7e41\u9ed8\u8ba4\u8bfb\u53d6\u7684\uff0c\u6c9f\u901a\u540e\u6700\u7ec8\u5f62\u62103\u4e2a\u5168\u5c40\u89c4\u5219\u548c2\u4e2a\u9879\u76ee\u89c4\u5219\u6587\u4ef6\u3002</p> <p> </p> <ol> <li>\u5b58\u7591</li> </ol> <p>\u7ecf\u8fc7\u4e00\u6bb5\u65f6\u95f4\u7684\u5f00\u53d1\u540e\uff0c\u5c24\u5176\u662f\u89c2\u5bdfAgent\u7684\u5177\u4f53\u601d\u8003\u8fc7\u7a0b\u540e\uff0c\u4f5c\u8005\u53d1\u73b0\u82e5\u5e72\u95ee\u9898\uff0c\u6bd4\u5982\uff1a</p> <ul> <li>\u91cd\u590d\u505aPlan</li> <li>Rule\u91cc\u6709\u4e00\u4e9b\u5c5e\u4e8eSkills\u3001workflow\u6216\u5176\u4ed6\u5177\u4f53\u64cd\u4f5c\u8303\u7574\u7684\u5185\u5bb9</li> <li>\u957f\u671f\u4f1a\u9057\u5fd8</li> <li>3\u4e2a\u5168\u5c40\u89c4\u5219\u6587\u4ef6\u7a0d\u663e\u5197\u4f59</li> </ul> <p>\u9042\u6539\u4e4b\u3002</p>","tags":["projects","histmap","Agent"]},{"location":"project/2026/07/10/glrule-%E6%94%B9%E5%86%99/#_2","title":"\u6539\u5199\u7ed3\u679c","text":"<p>\u6539\u5199\u540e\u53d8\u4e3a\u4e00\u4e2a\u6587\u4ef67\u6761\u89c4\u5219\u3002\u91cd\u70b9\u5305\u62ec\uff1a</p> <ul> <li>\u82f1\u6587\u64cd\u4f5c\uff0c\u4e2d\u6587\u56de\u7b54\u3002</li> <li>Clarify before implementation.</li> <li>Plan -&gt; Act -&gt; Verify \u5de5\u4f5c\u8282\u594f</li> <li>\u672a\u7ecf\u5141\u8bb8\u4e0d\u8981\u968f\u610f\u66f4\u6539\u6587\u4ef6\u548c\u7cfb\u7edf\u8bbe\u7f6e</li> <li>\u591aAgent\u4e0d\u8981\u540c\u65f6\u4fee\u6539\u540c\u4e00\u4e2a\u6587\u4ef6\u5939/\u6587\u4ef6\u3002</li> </ul>","tags":["projects","histmap","Agent"]},{"location":"project/2026/07/11/%E5%AE%98%E6%96%B9%E5%85%A8%E5%9B%BD%E7%9C%81%E5%B8%82%E5%8E%BF%E8%A1%8C%E6%94%BF%E8%BE%B9%E7%95%8C%E7%9F%A2%E9%87%8F%E6%95%B0%E6%8D%AE%E7%9A%84%E8%8E%B7%E5%8F%96%E5%92%8C%E5%A4%84%E7%90%86/","title":"\u5929\u5730\u56fe\u2014\u2014\u56fd\u5bb6\u6807\u51c6\u77e2\u91cf\u5730\u56fe\u7684\u83b7\u53d6\u548c\u5904\u7406","text":"<p>\u7531\u4e8e\u6211\u56fd\u5bf9\u5730\u56fe\u7c7b\u51fa\u7248\u7269\u7684\u5ba1\u67e5\u8f83\u4e3a\uff08\u7c97\u7cd9\u7684\uff09\u4e25\u683c\uff0c\u672c\u6b21\u5f00\u53d1\u7684\u5386\u53f2\u5730\u56fe\u7ebf\u4e0a\u9879\u76ee\u6240\u6d89\u53ca\u7684\u884c\u653f\u8fb9\u754c\u9700\u91c7\u7528\u5b98\u65b9\u53d1\u5e03\u7684\u6570\u636e\uff0c\u5373\uff1a\u5929\u5730\u56fe\u3002</p>","tags":["projects","histmap","GIS","\u6570\u636e\u96c6\uff08\u4f9b\u4e0b\u8f7d\uff09"]},{"location":"project/2026/07/11/%E5%AE%98%E6%96%B9%E5%85%A8%E5%9B%BD%E7%9C%81%E5%B8%82%E5%8E%BF%E8%A1%8C%E6%94%BF%E8%BE%B9%E7%95%8C%E7%9F%A2%E9%87%8F%E6%95%B0%E6%8D%AE%E7%9A%84%E8%8E%B7%E5%8F%96%E5%92%8C%E5%A4%84%E7%90%86/#_2","title":"\u6570\u636e\u83b7\u53d6","text":"<ol> <li>\u7f51\u7ad9</li> </ol> <p>https://www.tianditu.gov.cn/ \u56fd\u5bb6\u5730\u7406\u4fe1\u606f\u516c\u5171\u670d\u52a1\u5e73\u53f0</p> <p></p> <ol> <li>\u8def\u5f84</li> </ol> <p>\u5929\u5730\u56fe\u4e3b\u9875\u6ce8\u518c\u8d26\u53f7 \u2192 \u8fdb\u5165\u6570\u636e\u5171\u4eab\u4e2d\u5fc3 \u2192 \u9009\u62e9\u201c\u884c\u653f\u533a\u5212\u53ef\u89c6\u5316\u201d\u677f\u5757 \u2192 \u4e0b\u8f7d\u6570\u636e</p> <p></p> <p></p> <ol> <li>\u6570\u636e\u57fa\u7840\u4fe1\u606f</li> </ol> \u5c5e\u6027 \u4fe1\u606f \u5ba1\u56fe\u53f7 GS(2024)0605\u53f7 \u4e0b\u8f7d\u683c\u5f0f GeoJSON \u6570\u636e\u66f4\u65b0\u65f6\u95f4 2025\u5e749\u6708 \u5750\u6807\u7cfb CGCS2000 (EPSG:4490) <ol> <li>\u6570\u636e\u5c5e\u6027\u8868</li> </ol> <p></p> \u5c5e\u6027\u540d \u542b\u4e49 \u793a\u4f8b name \u540d\u79f0 \u201c\u6cb3\u5357\u7701\u201d\uff1b\u201c\u6885\u5dde\u5e02\u201d\uff1b\u201c\u9102\u57ce\u533a\u201d gb \u884c\u653f\u533a\u5212\u7f16\u7801 156410000","tags":["projects","histmap","GIS","\u6570\u636e\u96c6\uff08\u4f9b\u4e0b\u8f7d\uff09"]},{"location":"project/2026/07/11/%E5%AE%98%E6%96%B9%E5%85%A8%E5%9B%BD%E7%9C%81%E5%B8%82%E5%8E%BF%E8%A1%8C%E6%94%BF%E8%BE%B9%E7%95%8C%E7%9F%A2%E9%87%8F%E6%95%B0%E6%8D%AE%E7%9A%84%E8%8E%B7%E5%8F%96%E5%92%8C%E5%A4%84%E7%90%86/#_3","title":"\u68c0\u67e5\u5904\u7406","text":"<ul> <li>\u68c0\u67e5\u62d3\u6251gap\u548coverlap\u4e24\u9879\uff0c\u4ecd\u7136\u5b58\u5728\u96f6\u661f\u5c0f\u95ee\u9898\uff0c\u4f46\u4e0d\u5f71\u54cd\u5de5\u4f5c\uff0c\u61d2\u5f97\u5904\u7406\u4e86\u3002</li> </ul> <ul> <li>\u6709\u4e9b\u98de\u5730\u6211\u4e0d\u6e05\u695a\u662f\u9519\u8bef\u8fd8\u662f\u672c\u5c31\u5982\u6b64\u3002\u4e0d\u505a\u5904\u7406\u3002</li> </ul>","tags":["projects","histmap","GIS","\u6570\u636e\u96c6\uff08\u4f9b\u4e0b\u8f7d\uff09"]},{"location":"project/2026/07/11/%E5%AE%98%E6%96%B9%E5%85%A8%E5%9B%BD%E7%9C%81%E5%B8%82%E5%8E%BF%E8%A1%8C%E6%94%BF%E8%BE%B9%E7%95%8C%E7%9F%A2%E9%87%8F%E6%95%B0%E6%8D%AE%E7%9A%84%E8%8E%B7%E5%8F%96%E5%92%8C%E5%A4%84%E7%90%86/#_4","title":"\u5410\u69fd","text":"<ul> <li>\u8fb9\u754c\u6700\u540e\u7684\u8fd1\u4f3c\u5904\u7406\u53ef\u4ee5\u8bf4\u662f\u6bd4\u8f83\u4e11\u4e86</li> <li>\u6ca1\u6709\u57fa\u7840\u56fe\u5f62\u5916\u7684\u5176\u4ed6\u5c5e\u6027\u5b57\u6bb5\uff0c\u548c\u7528\u7231\u53d1\u7535\u7684\u4e00\u4f17\u81ea\u5236\u8fb9\u754c\u535a\u4e3b\u6bd4\u8f83\u663e\u5f97\u5c31\u5f88\u8d2b\u4e4f\u4e86\u3002\u4e0d\u8fc7\u5bf9\u5b98\u65b9\u8981\u6c42\u80fd\u8fbe\u5230 ==\u51c6\u786e\u3001\u53ca\u65f6\u3001\u65b9\u4fbf\u5730\u63d0\u4f9b\u5f00\u653e\u4e0b\u8f7d== \u5927\u5bb6\u5c31\u5df2\u7ecf\u77e5\u8db3\u4e86\u3002\u4e0d\u7136\u65e0\u636e\u53ef\u4f9d\u3002\u2014\u2014\u201c\u4f60\u8bf4\u6211\u4e0d\u884c\uff0c\u6574\u5929\u5404\u79cd\u7406\u7531\u5361\u6211\uff0c\u90a3\u4f60\u5012\u662f\u62ff\u51fa\u4e2a\u884c\u7684\u554a\u3002\u201d</li> </ul>","tags":["projects","histmap","GIS","\u6570\u636e\u96c6\uff08\u4f9b\u4e0b\u8f7d\uff09"]},{"location":"project/2026/07/13/%E6%B8%AF%E6%BE%B3%E5%8F%B0%E5%8E%86%E5%8F%B2%E6%96%87%E5%8C%96%E9%81%97%E4%BA%A7%E5%9C%B0%E5%9B%BE/","title":"\u53f0\u6e7e\u5386\u53f2\u6587\u5316\u9057\u4ea7\u6570\u636e","text":"","tags":["projects","histmap","\u6570\u636e\u96c6\uff08\u4f9b\u4e0b\u8f7d\uff09"]},{"location":"project/2026/07/13/%E6%B8%AF%E6%BE%B3%E5%8F%B0%E5%8E%86%E5%8F%B2%E6%96%87%E5%8C%96%E9%81%97%E4%BA%A7%E5%9C%B0%E5%9B%BE/#_2","title":"\u6570\u636e\u83b7\u53d6","text":"<p>\u4f7f\u7528Agent\uff08\u6ce8\uff1acursor\uff09\u7f51\u7edc\u722c\u53d6\u53f0\u6e7e\u7701\u5386\u53f2\u6587\u5316\u9057\u4ea7\u76f8\u5173\u9875\u9762\u4e0a\u7684\u6570\u636e\u5e76\u6839\u636e\u5730\u7406\u4f4d\u7f6e\u4fe1\u606f\u751f\u6210\u5bf9\u5e94\u5750\u6807\uff0c\u8f93\u51fa.csv\u8868\u683c\u548c.geojson\u6587\u4ef6\u3002</p> <p></p>","tags":["projects","histmap","\u6570\u636e\u96c6\uff08\u4f9b\u4e0b\u8f7d\uff09"]},{"location":"project/2026/07/13/%E6%B8%AF%E6%BE%B3%E5%8F%B0%E5%8E%86%E5%8F%B2%E6%96%87%E5%8C%96%E9%81%97%E4%BA%A7%E5%9C%B0%E5%9B%BE/#_3","title":"\u5b58\u5728\u95ee\u9898","text":"<p>\u5bf9\u521d\u59cb\u751f\u6210\u7684\u6587\u4ef6\u8fdb\u884c\u9884\u89c8\uff0c\u53d1\u73b0\u53ef\u80fd\u5b58\u5728\u4ee5\u4e0b\u95ee\u9898\uff1a</p> <ul> <li>\u5750\u6807\u751f\u6210\u6709\u8bef</li> <li>\u9057\u4ea7\u70b9\u6709\u91cd\u590d</li> <li>\u4fe1\u606f\u7f3a\u5931\u6216\u4fe1\u606f\u6709\u8bef</li> <li>\u548c\u5b98\u65b9\u884c\u653f\u8fb9\u754c\u5b58\u5728\u5dee\u5f02</li> <li>\u5206\u7c7b\u6807\u51c6\u4e0d\u4e00\u81f4</li> <li>\u5176\u4ed6\u95ee\u9898</li> </ul>","tags":["projects","histmap","\u6570\u636e\u96c6\uff08\u4f9b\u4e0b\u8f7d\uff09"]},{"location":"project/2026/07/13/%E6%B8%AF%E6%BE%B3%E5%8F%B0%E5%8E%86%E5%8F%B2%E6%96%87%E5%8C%96%E9%81%97%E4%BA%A7%E5%9C%B0%E5%9B%BE/#_4","title":"\u5904\u7406\u8bf4\u660e","text":"<p>\u7531\u4e8e\u9879\u76ee\u4ecd\u5904\u4e8e\u7b2c\u4e00\u7248\u72b6\u6001\uff0c\u4e34\u8fd1\u53d1\u5e03\uff0c\u76ee\u524d\u4e5f\u6ca1\u6709\u5408\u9002\u7684\u5b98\u65b9\u8d44\u6599\u4f5c\u4e3a\u53c2\u8003\uff0c\u6b64\u6b21\u4ec5\u5bf9\u884c\u653f\u8fb9\u754c\u548c\u4e00\u4e9b\u660e\u663e\u9519\u8bef\u8fdb\u884c\u5904\u7406\u3002\u7b80\u5355\u7684\u6570\u636e\u5bf9\u9f50\u539f\u5219\u5728\u9879\u76ee\u53d1\u5e03\u65f6\u4f1a\u7ed9\u4e88\u7b80\u7565\u8bf4\u660e\u3002</p>","tags":["projects","histmap","\u6570\u636e\u96c6\uff08\u4f9b\u4e0b\u8f7d\uff09"]},{"location":"project/2026/07/13/%E6%B8%AF%E6%BE%B3%E5%8F%B0%E5%8E%86%E5%8F%B2%E6%96%87%E5%8C%96%E9%81%97%E4%BA%A7%E5%9C%B0%E5%9B%BE/#_5","title":"\u9999\u6e2f\u5386\u53f2\u6587\u5316\u9057\u4ea7\u6570\u636e","text":"<ol> <li>\u6570\u636e\u6765\u6e90</li> </ol> <p>https://www.amo.gov.hk/tc/historic-buildings/monuments/index.html </p> <p></p> <ol> <li>\u5904\u7406\u8bf4\u660e</li> </ol> <p>\u7b80\u5355\u7684\u6570\u636e\u5bf9\u9f50\u539f\u5219\u5728\u9879\u76ee\u53d1\u5e03\u65f6\u4f1a\u7ed9\u4e88\u7b80\u7565\u8bf4\u660e\u3002</p>","tags":["projects","histmap","\u6570\u636e\u96c6\uff08\u4f9b\u4e0b\u8f7d\uff09"]},{"location":"project/2026/07/13/%E6%B8%AF%E6%BE%B3%E5%8F%B0%E5%8E%86%E5%8F%B2%E6%96%87%E5%8C%96%E9%81%97%E4%BA%A7%E5%9C%B0%E5%9B%BE/#_6","title":"\u6fb3\u95e8\u5386\u53f2\u6587\u5316\u9057\u4ea7\u6570\u636e","text":"<ol> <li>\u6570\u636e\u6765\u6e90</li> </ol> <p>https://www.culturalheritage.mo/</p> <p></p> <ol> <li>\u5904\u7406\u8bf4\u660e</li> </ol> <p>\u7b80\u5355\u7684\u6570\u636e\u5bf9\u9f50\u539f\u5219\u5728\u9879\u76ee\u53d1\u5e03\u65f6\u4f1a\u7ed9\u4e88\u7b80\u7565\u8bf4\u660e\u3002</p>","tags":["projects","histmap","\u6570\u636e\u96c6\uff08\u4f9b\u4e0b\u8f7d\uff09"]},{"location":"blog/archive/2026/","title":"2026","text":""},{"location":"blog/category/%E7%8E%AF%E5%A2%83%E6%90%AD%E5%BB%BA/","title":"\u73af\u5883\u642d\u5efa","text":""},{"location":"project/archive/2026/","title":"2026","text":""},{"location":"project/category/%E9%A1%B9%E7%9B%AE%E7%BB%86%E9%83%A8/","title":"\u9879\u76ee\u7ec6\u90e8","text":""}]}